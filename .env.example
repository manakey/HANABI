# Cloudinary を使う場合はこの3つを設定してください(未設定ならローカルの uploads/ フォルダに保存されます)
# 無料アカウント作成: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# プッシュ通知(Web Push)を使う場合はこの2つを設定してください(未設定ならプッシュ通知は無効になります)
# 生成方法: ターミナルで `npx web-push generate-vapid-keys` を実行するとpublic/privateキーが表示されます
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# デプロイ先が自動で設定する場合が多いので通常は空でOK
PORT=3000
